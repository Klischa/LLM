<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Заголовок виджета -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="LLM"
            android:src="@drawable/ic_widget_sparkle" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="LLM"
            android:textColor="#F2F3F7"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_model_badge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Офлайн GGUF"
            android:textColor="#89B4FA"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/widget_btn_quick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_input_bg"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="⚡ Запрос"
            android:textColor="#A6E3A1"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Поле отображения ответа / статуса -->
    <TextView
        android:id="@+id/widget_text_response"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp"
        android:maxLines="4"
        android:text="Нажмите, чтобы задать вопрос модели..."
        android:textColor="#BAC2DE"
        android:textSize="12sp" />

    <!-- Минималистичная полоса быстрого ввода запроса -->
    <LinearLayout
        android:id="@+id/widget_input_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_input_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="7dp"
        android:paddingEnd="10dp"
        android:paddingBottom="7dp">

        <TextView
            android:id="@+id/widget_input_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Задайте вопрос LLM..."
            android:textColor="#7F849C"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/widget_btn_send"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="6dp"
            android:contentDescription="Отправить"
            android:src="@drawable/ic_send_widget" />
    </LinearLayout>

</LinearLayout>
